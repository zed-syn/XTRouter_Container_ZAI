# Operator-only (never publish). Copy to operator.env and fill in.
# Used by build.sh / go run ./cmd/bake to resolve MCP URL when --url is not passed.

# Option A — full URL (simplest):
# MCP_URL=https://mcp.example.com/your-prefix/mcp

# Option B — same as local-agent-bridge .env:
# BRIDGE_PUBLIC_BASE_URL=https://mcp.example.com
# BRIDGE_PUBLIC_PATH_PREFIX=your-prefix

# Optional: load bridge .env automatically during build
# BRIDGE_ROOT=C:/Users/you/Desktop/xt-tool/mcp_tool_zai/local-agent-bridge
