# Public GitHub = decoy cmd/xzglm + internal/demo + .env.example + README + binaries under build/.
# Real Go sources, prompts, templates, and operator docs stay LOCAL.

/cmd/*
!/cmd/xzglm/
/cmd/xzglm/*
!/cmd/xzglm/main.go
/cmd/gateway/
/internal/*
!/internal/demo/
!/internal/demo/**
/build.sh
/go.local.mod
/go.local.sum
/tools/

# Operator-only (never push)
/README.operator.md
/operator.env.example
/operator.env
/PROMPT.md
/claude.md
/PROMPT*.md
/prompts/
/private/
/templates/
/public/*
!/public/SETUP.md
!/public/quick-start.sh
/secrets/

# Release staging (copy selected artifacts to repo root for commit)
/build/release/
!/build/glm-pool-1/
!/build/glm-pool-1/**
!/scripts/
!/scripts/**
!/start.sh

# Secrets + release embed
/internal/config/embedded_release.secret
/internal/config/lit_release_data.go
/internal/pool/embed/

.env
*.log
go.mod.decoy.bak
go.sum.decoy.bak
/build/.genlit.exe
/build/.context_session
/build/bake.exe
/build/genlit.exe
/build/renderprompt.exe
/build/xzglm-linux-amd64
/build/xzglm-linux-arm64
/build/xzglm-windows-amd64.exe
build/*-public.exe
build/*-new.exe
build/*-test.exe
/.deps/
